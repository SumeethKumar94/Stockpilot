# Copy this file to ".env" (cp .env.example .env) and adjust if needed.

# Port the API listens on (the Angular dev server proxies /api to this port)
PORT=3000

# Connection string for the main database
DATABASE_URL=postgres://inventory_user:inventory_pass@localhost:5432/inventory_db

# Separate database used ONLY by `npm test` (its tables are wiped on every run!)
TEST_DATABASE_URL=postgres://inventory_user:inventory_pass@localhost:5432/inventory_test_db

# Products with stock at or below this number are flagged "low stock"
LOW_STOCK_THRESHOLD=10
