{
  "name": "inventory-backend",
  "version": "1.0.0",
  "description": "Express + PostgreSQL API for the inventory management app",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/db.js init",
    "db:seed": "node scripts/db.js seed",
    "db:reset": "node scripts/db.js reset",
    "test": "jest --runInBand --forceExit",
    "sanity": "node scripts/sanity-check.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000
  }
}
